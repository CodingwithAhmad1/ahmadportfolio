---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NameHero from '../components/NameHero.astro';
import { projects } from '../site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base>
  <NameHero />

  <section class="wrap block">
    <h2>Selected work</h2>
    <ul class="rows">
      {projects.slice(0, 3).map((p) => (
        <li>
          <a href={p.href}>
            <span class="title">{p.title}</span>
            <span class="meta">{p.stack}, {p.year}</span>
            <span class="summary">{p.summary}</span>
          </a>
        </li>
      ))}
    </ul>
    <p><a href="/work">See all work</a></p>
  </section>

  <section class="wrap block">
    <h2>Recent writing</h2>
    <ul class="rows">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`}>
            <span class="title">{post.data.title}</span>
            <time class="meta" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <span class="summary">{post.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
    <p><a href="/blog">Read all posts</a></p>
  </section>
</Base>

<style>
  .block { margin-top: clamp(4rem, 10vh, 7rem); }
</style>
