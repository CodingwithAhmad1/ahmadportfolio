---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Flex from '../components/Flex.astro';
import Boot from '../components/Boot.astro';
import TradingFloor from '../components/TradingFloor.astro';
import BacktestDemo from '../components/BacktestDemo.astro';
import AtlasRadar from '../components/toys/AtlasRadar.astro';
import ReportDesk from '../components/toys/ReportDesk.astro';
import CaseDeck from '../components/toys/CaseDeck.astro';
import ParliamentBoard from '../components/toys/ParliamentBoard.astro';
import { getProjects } from '../lib/projects';
import { variants, meta, NAIVE, DEFAULT, pct } from '../lib/demo';
import { site } from '../site';

const projects = await getProjects();
const engine = projects.find((p) => p.data.flagship)!;
const work = projects.filter((p) => !p.data.flagship);

// Each project's live demo, shown when its row opens.
const toys: Record<string, any> = {
  'student-atlas': AtlasRadar,
  reportiq: ReportDesk,
  jurislearning: CaseDeck,
  'speak-up': ParliamentBoard,
};

const naive = variants[NAIVE].kpis;
const real = variants[DEFAULT].kpis;

// The tape that runs along the top of the engine. Every item is a real result or a real feature.
const tape = [
  `${meta.strategy}`,
  `naive ${pct(naive.return)}`,
  `after real costs ${pct(real.return)}`,
  `sharpe ${naive.sharpe.toFixed(2)} → ${real.sharpe.toFixed(2)}`,
  'fills at next bar open',
  'fee 0.5bp',
  'slippage 0.75bp',
  'look-ahead: impossible to write',
  'walk-forward',
  'deflated sharpe',
  "hansen's spa",
  'monte carlo',
  'live ↔ backtest parity',
  '75 tools over mcp',
];

// The same tape, running through the outlined letters of the wordmark.
const tapeLine = (tape.join('   ·   ') + '   ·   ').toUpperCase();
const tapeRows = Array.from({ length: 12 }, (_, i) => ({
  y: 14 + i * 17,
  shift: (i * 137) % 400,
  amber: i % 3 === 1,
}));

const statusOf = (s: string) => (s === 'Private' ? 'In use' : s);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base>
  <Fragment slot="head">
    <script is:inline>
      // Arm the boot before first paint: first arrival on the home page only, never
      // when coming back from another page here, following a link to a project,
      // or with reduced motion. A timer clears it if anything goes wrong.
      (function () {
        var d = document.documentElement;
        try {
          var force = /[?&]boot\b/.test(location.search);
          if (!force) {
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            if (location.hash) return;
            if (document.referrer && new URL(document.referrer).origin === location.origin) return;
          }
        } catch (e) { return; }
        d.classList.add('boot');
        setTimeout(function () {
          if (d.classList.contains('boot')) { d.classList.remove('boot'); d.classList.add('booted'); }
        }, 6000);
      })();
    </script>
  </Fragment>

  <Boot />

  <div class="story" data-story>
    <svg class="thread" aria-hidden="true">
      <path class="track" data-track />
      <path class="lit" data-lit />
      <circle class="head" r="4" data-head />
    </svg>

    <!-- Act 1: who -->
    <section class="hero wrap">
      <h1 class="statement wave"><Flex text={site.statement} /></h1>
      <div class="baseline" data-baseline></div>
      <div class="hero-foot">
        <p class="intro">{site.intro}</p>
        <ol class="board" aria-label="What I'm building, and where each one is">
          {projects.map((p) => (
            <li data-world={p.id}>
              <a href={p.data.flagship ? '#engine' : `#${p.id}`} data-open={p.data.flagship ? undefined : p.id}>
                <span class="dot" aria-hidden="true"></span>
                <span class="b-name" data-flap>{p.data.title}</span>
                <span class="b-for">{p.data.flagship ? 'Funds the rest' : p.data.people}</span>
                <span class="b-status" data-flap>{p.data.flagship ? 'In research' : statusOf(p.data.status)}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Act 2: the mission -->
    <section id="mission" class="mission" aria-labelledby="mission-title">
      <header class="wrap act">
        <p class="kicker">The mission</p>
        <h2 id="mission-title">Four groups of people who usually get overlooked. One tool for each.</h2>
      </header>

      <div class="work" id="work">
        {work.map((p) => {
          const Toy = toys[p.id];
          return (
            <details name="work" class="world" data-world={p.id} id={p.id} data-station-row>
              <summary class="wrap row">
                <span class="station" data-station aria-hidden="true"></span>
                <span class="who">For {p.data.people}</span>
                <span class="name"><Flex text={p.data.title} /></span>
                <span class="problem">{p.data.problem}</span>
                <span class="status">{statusOf(p.data.status)}</span>
                <span class="plus" aria-hidden="true"></span>
              </summary>
              <div class="wrap panel">
                <div class="pitch">
                  <p class="tagline">{p.data.tagline}</p>
                  <dl class="stats">
                    {p.data.stats.map((s) => (
                      <div>
                        <dt>{s.label}</dt>
                        <dd>{s.value}</dd>
                        <dd class="src">{s.source}</dd>
                      </div>
                    ))}
                  </dl>
                  <p class="links">
                    <a href={`/work/${p.id}`}>How it works</a>
                    {p.data.links.live && <a href={p.data.links.live}>Open the live site</a>}
                    {p.data.links.repo && <a href={p.data.links.repo}>Read the source</a>}
                  </p>
                </div>
                <div class="toy">{Toy && <Toy />}</div>
              </div>
            </details>
          );
        })}
      </div>
    </section>

    <!-- Act 3: why the engine exists -->
    <section class="bridge" data-bridge aria-label="Why the engine exists">
      <div class="bridge-pin wrap">
        <p class="bridge-text">
          {site.bridge.split(' ').map((w) => <span>{w} </span>)}
        </p>
      </div>
    </section>

    <!-- Act 4: the engine -->
    <section id="engine" class="engine" data-world={engine.id} aria-labelledby="engine-title">
      <TradingFloor />
      <div class="tape" aria-hidden="true" data-thread-end>
        <div class="tape-run">
          {[0, 1].map(() => tape.map((t) => <span>{t}</span>))}
        </div>
      </div>

      <div class="wrap engine-body">
        <p class="kicker">The engine</p>
        <h2 id="engine-title" class="wordmark" style={`view-transition-name: title-${engine.id}`}>
          <span class="visually-hidden">Invictus</span>
          <!-- The tape is clipped to the letters' filled shapes. The outline is the
               text's stroke with its inside masked away, so the overlapping contours
               inside Syne's heavy glyphs never show. viewBox is fitted after fonts load. -->
          <svg class="wm" viewBox="0 -170 1140 210" aria-hidden="true" data-wordmark>
            <defs>
              <clipPath id="wm-clip"><text class="wm-text" y="0">Invictus</text></clipPath>
              <mask id="wm-outside" maskUnits="userSpaceOnUse" x="-50" y="-300" width="2000" height="500">
                <rect x="-50" y="-300" width="2000" height="500" fill="#fff" />
                <text class="wm-text" y="0" fill="#000">Invictus</text>
              </mask>
            </defs>
            <g clip-path="url(#wm-clip)">
              <g class="wm-run">
                {tapeRows.map((r) => (
                  <text x={-r.shift} y={r.y - 180} class:list={['wm-row', { amber: r.amber }]}>{tapeLine}{tapeLine}{tapeLine}</text>
                ))}
              </g>
            </g>
            <text class="wm-text wm-outline" y="0" mask="url(#wm-outside)">Invictus</text>
          </svg>
        </h2>
        <div class="thesis">
          <p class="thesis-lead">{engine.data.problem}</p>
          <p>
            Invictus is the trading research platform I'm building to fund everything above. It doesn't make money yet.
            It's built on one rule: <strong>a result only counts if it survives the costs and timing you'd face with real money.</strong>
          </p>
        </div>

        <div class="desk">
          <div class="desk-bar">
            <span>Invictus / research</span>
            <span>{meta.strategy} · synthetic FX · {meta.market.bar}</span>
          </div>
          <p class="desk-intro">
            Try it. A real strategy from the Invictus library, on a market generated with <em>no edge at all</em>.
            The naive backtest says <span class="up">{pct(naive.return)}</span>. Add what a broker actually charges.
          </p>
          <BacktestDemo id="home-demo" />
        </div>

        <h3 class="modules-title">What it does that most backtesters don't</h3>
        <ul class="modules">
          {engine.data.features.map((f) => (
            <li>
              <span class="mod-state" aria-hidden="true">● on</span>
              <h4>{f.title}</h4>
              <p>{f.detail}</p>
            </li>
          ))}
        </ul>

        <dl class="stats engine-stats">
          {engine.data.stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
              <dd class="src">{s.source}</dd>
            </div>
          ))}
        </dl>
        <p class="links"><a href={`/work/${engine.id}`}>How Invictus works</a></p>
      </div>
    </section>

    <!-- Act 5: the loop closes -->
    <section class="loop wrap" data-loop aria-labelledby="loop-title">
      <h2 id="loop-title">It doesn't pay yet. <span>When it does, this is where it goes.</span></h2>
      <svg class="branches" viewBox="0 0 1000 260" aria-hidden="true">
        <defs>
          {work.map((p) => (
            <linearGradient id={`g-${p.id}`} x1="0" y1="0" x2="0" y2="1" data-world={p.id}>
              <stop offset="0" stop-color="#ffb000" />
              <stop offset="1" class="stop-world" />
            </linearGradient>
          ))}
        </defs>
        {work.map((p, i) => {
          const x = 125 + i * 250;
          return <path pathLength="1" stroke={`url(#g-${p.id})`} d={`M500,0 V70 C500,160 ${x},120 ${x},260`} style={`--d:${i * 120}ms`} />;
        })}
      </svg>
      <ul class="ends">
        {work.map((p) => (
          <li data-world={p.id}>
            <a href={`#${p.id}`} data-open={p.id}>
              <span class="e-name">{p.data.title}</span>
              <span class="e-for">{p.data.people}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  {posts.length > 0 && (
    <section class="wrap writing">
      <h2>Writing</h2>
      <ul class="rows">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>
              <span class="title">{post.data.title}</span>
              <time class="meta" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
              <span class="summary">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  :global(html.boot) { overflow: hidden; }

  .story { position: relative; }
  .kicker {
    margin: 0;
    font: 500 0.8rem var(--code);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--signal);
  }

  /* The thread: one amber line from the hero's baseline down to the engine. */
  .thread { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; z-index: 2; }
  .thread path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .track { stroke: var(--line); stroke-width: 1; }
  .lit { stroke: var(--signal); stroke-width: 2; filter: drop-shadow(0 0 6px rgba(255, 176, 0, 0.7)); }
  .head { fill: var(--signal); filter: drop-shadow(0 0 8px var(--signal)); }

  /* Act 1 */
  .hero { padding-top: clamp(2.5rem, 9vh, 7rem); padding-bottom: clamp(3rem, 9vh, 6rem); }
  .statement {
    margin: 0;
    font-size: clamp(3.25rem, 10.5vw, 10.5rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    font-weight: 420;
    max-width: 11ch;
  }
  .baseline {
    height: 2px;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    margin-left: calc(-1 * var(--rail-off));
    background: var(--signal);
    box-shadow: 0 0 12px rgba(255, 176, 0, 0.6);
    transform-origin: left;
    animation: draw-x 1.1s cubic-bezier(0.6, 0, 0.2, 1) both;
  }
  :global(html.boot) .baseline, :global(html.booted) .baseline { animation: none; }
  @keyframes draw-x { from { transform: scaleX(0); } }

  /* After the boot, the statement rises off the baseline it just landed on. */
  :global(html.boot) .statement :global(.ch) { opacity: 0; }
  :global(html.booted) .statement :global(.ch) {
    animation: rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    animation-delay: calc(var(--i) * 22ms);
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(0.5em) rotate(4deg); }
  }
  :global(html.boot) .hero-foot { opacity: 0; }
  :global(html.booted) .hero-foot { animation: fade-up 0.8s 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) backwards; }
  @keyframes fade-up { from { opacity: 0; transform: translateY(1rem); } }

  .hero-foot {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2rem 4rem;
    margin-top: 2rem;
    align-items: start;
  }
  .intro { margin: 0; max-width: 30rem; font-size: clamp(1.2rem, 1.8vw, 1.45rem); line-height: 1.45; }

  /* A departures board of the five projects. */
  .board { list-style: none; margin: 0; padding: 0; font: 0.82rem var(--code); border-top: 1px solid var(--line); }
  .board li { border-bottom: 1px solid var(--line); }
  .board a {
    display: grid;
    grid-template-columns: 0.75rem minmax(0, 1.1fr) minmax(0, 1.4fr) minmax(0, 0.8fr);
    gap: 0.75rem;
    align-items: center;
    padding: 0.6rem 0.25rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: background-color 0.2s ease, padding 0.2s ease;
  }
  .board a:hover, .board a:focus-visible { background: color-mix(in srgb, var(--world) 14%, transparent); padding-left: 0.6rem; }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--world); box-shadow: 0 0 8px var(--world); }
  .b-name { font-weight: 700; color: var(--ink); }
  .b-for { color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-transform: none; letter-spacing: 0; }
  .b-status { text-align: right; color: var(--world); }

  /* Act 2 */
  .act { padding-top: clamp(4rem, 12vh, 8rem); padding-bottom: clamp(2rem, 5vh, 3rem); }
  .act h2 {
    margin: 0.75rem 0 0;
    max-width: 20ch;
    font-size: clamp(2rem, 4.4vw, 3.75rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .story { --rail-off: clamp(8px, 1.6vw, 26px); }

  .work { border-top: 1px solid var(--line); }
  .world { border-bottom: 1px solid var(--line); transition: background-color 0.45s ease; }
  .world[open] {
    --paper: var(--world);
    --paper-2: color-mix(in srgb, var(--world) 88%, var(--on));
    --ink: var(--on);
    --muted: color-mix(in srgb, var(--on) 68%, var(--world));
    --line: color-mix(in srgb, var(--on) 28%, var(--world));
    --accent: var(--on);
    --ghost: color-mix(in srgb, var(--on) 42%, var(--world));
    background: var(--world);
    color: var(--on);
    border-bottom-color: transparent;
  }
  .world::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size 0.6s cubic-bezier(0.3, 0.7, 0.2, 1), content-visibility 0.6s allow-discrete;
  }
  .world[open]::details-content { block-size: auto; }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 19rem) auto;
    grid-template-areas: 'who who who' 'name problem plus' 'name status plus';
    align-items: center;
    gap: 0.15rem 2rem;
    padding-top: clamp(1.1rem, 2.4vw, 1.75rem);
    padding-bottom: clamp(1.1rem, 2.4vw, 1.75rem);
    cursor: pointer;
    list-style: none;
  }
  .row::-webkit-details-marker { display: none; }

  /* A station on the thread. It lights up in the project's colour as the line reaches it. */
  .station {
    position: absolute;
    left: calc(var(--gutter) - var(--rail-off));
    top: 50%;
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border-radius: 50%;
    background: var(--paper);
    border: 1.5px solid var(--line);
    z-index: 3;
    transition: background-color 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease, transform 0.35s cubic-bezier(0.2, 1.6, 0.4, 1);
  }
  .station::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    width: calc(var(--rail-off) - 10px);
    height: 1px;
    margin-left: 4px;
    background: var(--world);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s 0.1s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .world.reached .station { background: var(--world); border-color: var(--world); box-shadow: 0 0 14px var(--world); transform: scale(1.25); }
  .world.reached .station::after { transform: scaleX(1); }
  .world[open] .station { background: var(--on); border-color: var(--on); box-shadow: none; }
  .world[open] .station::after { background: var(--on); }

  .who {
    grid-area: who;
    font: 500 0.78rem var(--code);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--world);
  }
  .world[open] .who { color: var(--on); }
  .name {
    grid-area: name;
    font-family: var(--display);
    font-size: clamp(2.5rem, 7.4vw, 7.25rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    transition: color 0.3s ease, opacity 0.3s ease;
  }
  .world:not([open]) .row:hover .name, .world:not([open]) .row:focus-visible .name { color: var(--world); }
  .work:has(.row:hover) .world:not(:has(.row:hover)):not([open]) .name { opacity: 0.3; }
  .problem { grid-area: problem; align-self: end; font-size: 1rem; line-height: 1.35; }
  .status { grid-area: status; align-self: start; font: 500 0.75rem var(--code); letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.6; margin-top: 0.35rem; }
  .plus { grid-area: plus; position: relative; width: 1.75rem; height: 1.75rem; }
  .plus::before, .plus::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    background: currentColor;
    transition: transform 0.4s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .plus::after { transform: rotate(90deg); }
  .world[open] .plus::after { transform: rotate(0deg); }
  .world[open] .plus::before { transform: rotate(180deg); }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: 2.5rem 4rem;
    padding-top: 1rem;
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .tagline { margin: 0; font-size: clamp(1.3rem, 2.2vw, 1.75rem); line-height: 1.3; }
  .stats { margin: 2rem 0 0; display: grid; gap: 1.25rem; }
  .stats div { display: grid; grid-template-columns: auto 1fr; align-items: baseline; column-gap: 1rem; }
  .stats dt { grid-column: 2; grid-row: 1; font-size: 1rem; line-height: 1.3; }
  .stats dd { margin: 0; grid-column: 1; grid-row: 1 / span 2; font: 800 clamp(2.4rem, 4.5vw, 3.6rem) / 1 var(--display); letter-spacing: -0.03em; min-width: 2.2ch; white-space: nowrap; }
  .stats dd.src { grid-column: 2; grid-row: 2; font: 400 0.75rem / 1.3 var(--code); letter-spacing: 0; opacity: 0.65; min-width: 0; white-space: normal; }
  .links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: 2rem 0 0; font: 700 1rem var(--display); }

  /* Act 3: the words light up as you scroll, and the stage darkens into the floor. */
  .bridge { height: 220vh; background: linear-gradient(var(--paper) 30%, #060607); }
  .bridge-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
  }
  .bridge-text {
    margin: 0;
    max-width: 22ch;
    font: 600 clamp(2rem, 5vw, 4.5rem) / 1.08 var(--display);
    letter-spacing: -0.03em;
  }
  .bridge-text span { color: rgba(237, 235, 230, 0.14); transition: color 0.25s ease; }
  .bridge-text span.on { color: var(--ink); }
  .bridge-text span.on:nth-last-child(-n + 8) { color: var(--signal); }

  /* Act 4: the trading floor. */
  .engine {
    --paper: #060607;
    --paper-2: #0e0e11;
    --line: #23232b;
    --accent: var(--signal);
    --demo-bg: #0c0c0f;
    position: relative;
    background: #060607;
    padding-bottom: clamp(4rem, 12vh, 8rem);
  }
  .engine-body { position: relative; z-index: 1; padding-top: clamp(3rem, 9vh, 6rem); }

  .tape { position: relative; z-index: 2; overflow: hidden; background: var(--signal); color: #0b0b0c; }
  .tape-run { display: flex; width: max-content; animation: tape 60s linear infinite; }
  .tape span { padding: 0.55rem 1.25rem; font: 700 0.78rem var(--code); letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
  .tape span::before { content: '▲ '; }
  .tape span:nth-child(3n + 2)::before { content: '▼ '; }
  .tape:hover .tape-run { animation-play-state: paused; }
  @keyframes tape { to { transform: translateX(-50%); } }

  .wordmark { margin: 0.5rem 0 0; line-height: 0; }
  .wm { display: block; width: min(100%, 15rem * 5.6); height: auto; overflow: visible; }
  .wm-text { font: 800 200px var(--display); letter-spacing: -0.05em; }
  .wm-outline { fill: none; stroke: var(--signal); stroke-width: 3.5; filter: drop-shadow(0 0 18px rgba(255, 176, 0, 0.35)); }
  .wm-row { font: 700 12px var(--code); fill: #edebe6; fill-opacity: 0.55; white-space: pre; }
  .wm-row.amber { fill: var(--signal); fill-opacity: 1; }
  .wm-run { animation: wordmark-tape 40s linear infinite; }
  @keyframes wordmark-tape { to { transform: translateX(-33.333%); } }
  .wm-run { transform-box: fill-box; }

  .thesis { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem 4rem; margin: clamp(2rem, 5vw, 3.5rem) 0; font-size: 1.15rem; }
  .thesis p { margin: 0; }
  .thesis-lead { font: 600 clamp(1.5rem, 2.6vw, 2.2rem) / 1.15 var(--display); letter-spacing: -0.02em; }
  .thesis strong { color: var(--signal); font-weight: 500; }

  .desk {
    border: 1px solid var(--line);
    background: #0c0c0f;
    box-shadow: 0 0 0 1px rgba(255, 176, 0, 0.05), 0 40px 120px -40px rgba(255, 176, 0, 0.18);
  }
  .desk-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 1rem;
    background: #141418;
    border-bottom: 1px solid var(--line);
    font: 500 0.72rem var(--code);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .desk-bar span:first-child { color: var(--signal); }
  .desk-intro { margin: 0; padding: 1.25rem clamp(1rem, 2.5vw, 2rem) 0; max-width: 46rem; }
  .desk-intro .up { color: var(--gain); font-weight: 600; }
  .desk :global(.demo) { padding: 1.25rem clamp(1rem, 2.5vw, 2rem) clamp(1rem, 2.5vw, 2rem); }

  .modules-title { margin: clamp(3.5rem, 8vw, 6rem) 0 1.25rem; font-size: clamp(1.5rem, 2.6vw, 2.2rem); font-weight: 600; letter-spacing: -0.02em; }
  .modules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .modules li {
    position: relative;
    padding: 1.5rem 1.5rem 1.75rem;
    background: rgba(9, 9, 11, 0.86);
    backdrop-filter: blur(6px);
    transition: background-color 0.25s ease;
  }
  .modules li::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .modules li:hover { background: rgba(20, 16, 6, 0.92); }
  .modules li:hover::before { transform: scaleX(1); }
  .mod-state { font: 500 0.7rem var(--code); letter-spacing: 0.08em; text-transform: uppercase; color: var(--gain); }
  .modules h4 { margin: 0.6rem 0 0.5rem; font: 700 1.2rem / 1.2 var(--display); }
  .modules p { margin: 0; font-size: 1rem; line-height: 1.5; color: var(--muted); }

  .engine-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 1px; gap: 1px; background: var(--line); border: 1px solid var(--line); border-top: 0; }
  .engine-stats div { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem; background: rgba(9, 9, 11, 0.92); }
  .engine-stats dd { order: -1; color: var(--signal); }
  .engine-stats dd.src { order: 1; color: var(--muted); }
  .engine .links { margin-top: 2.5rem; }

  /* Act 5 */
  .loop { padding-top: clamp(5rem, 14vh, 9rem); text-align: center; }
  .loop h2 { margin: 0 auto; max-width: 24ch; font-size: clamp(1.9rem, 4vw, 3.4rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.03em; }
  .loop h2 span { display: block; color: var(--signal); }
  .branches { display: block; width: 100%; height: auto; margin-top: 2.5rem; overflow: visible; }
  .branches path {
    fill: none;
    stroke-width: 2.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.6, 0, 0.2, 1) var(--d);
  }
  .loop.drawn .branches path { stroke-dashoffset: 0; }
  .stop-world { stop-color: var(--world); }
  .ends { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .ends a { display: grid; gap: 0.25rem; padding: 1rem 0.5rem; text-decoration: none; border-top: 2px solid var(--world); transition: background-color 0.2s ease; }
  .ends a:hover { background: color-mix(in srgb, var(--world) 12%, transparent); }
  .e-name { font: 700 clamp(1rem, 1.8vw, 1.4rem) var(--display); color: var(--world); }
  .e-for { font-size: 0.95rem; color: var(--muted); }

  .writing { margin-top: clamp(4rem, 10vh, 7rem); }

  @media (max-width: 1000px) {
    .modules { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .panel, .hero-foot, .thesis { grid-template-columns: 1fr; }
    .engine-stats { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .row { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'who plus' 'name plus' 'problem problem' 'status status'; }
    .problem { margin-top: 0.5rem; }
    .board a { grid-template-columns: 0.75rem minmax(0, 1fr) auto; }
    .b-for { display: none; }
    .modules { grid-template-columns: 1fr; }
    .ends { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .desk-bar span:last-child { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bridge { height: auto; }
    .bridge-pin { position: static; height: auto; padding-top: 6rem; padding-bottom: 6rem; }
    .bridge-text span { color: var(--ink); }
    .loop .branches path { stroke-dashoffset: 0; }
  }
</style>

<script>
  import { scramble } from '../scripts/scramble';

  const html = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rows = [...document.querySelectorAll<HTMLDetailsElement>('details.world')];

  // Opening a row brings it to the top of the screen, once the previous one has closed.
  for (const d of rows) {
    d.addEventListener('toggle', () => {
      if (!d.open) return;
      history.replaceState(null, '', `#${d.id}`);
      setTimeout(() => d.scrollIntoView({ behavior: 'smooth', block: 'start' }), 80);
    });
  }
  const openFromHash = () => {
    const d = rows.find((r) => `#${r.id}` === location.hash);
    if (d) d.open = true;
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-open]')) {
    a.addEventListener('click', (e) => {
      const d = rows.find((r) => r.id === a.dataset.open);
      if (!d) return;
      e.preventDefault();
      d.open = true;
    });
  }

  // The departures board flips into place once the page is showing.
  const flap = () => {
    if (reduce) return;
    document.querySelectorAll<HTMLElement>('[data-flap]').forEach((el, i) => scramble(el, { duration: 600, delay: 250 + i * 45 }));
  };
  if (html.classList.contains('boot')) {
    new MutationObserver((_, obs) => {
      if (html.classList.contains('booted')) { obs.disconnect(); flap(); }
    }).observe(html, { attributes: true, attributeFilter: ['class'] });
  } else flap();

  // The thread. It runs along the hero's baseline, drops down the left margin past
  // each project's station, and ends where the engine's tape begins. It draws as you scroll.
  const story = document.querySelector<HTMLElement>('[data-story]')!;
  const svg = story.querySelector<SVGSVGElement>('.thread')!;
  const track = svg.querySelector<SVGPathElement>('[data-track]')!;
  const lit = svg.querySelector<SVGPathElement>('[data-lit]')!;
  const head = svg.querySelector<SVGCircleElement>('[data-head]')!;
  const baseline = story.querySelector<HTMLElement>('[data-baseline]')!;
  const stations = [...story.querySelectorAll<HTMLElement>('[data-station]')];
  const end = story.querySelector<HTMLElement>('[data-thread-end]')!;

  let geo = { x: 0, y0: 0, len: 0, lead: 0, total: 0, stops: [] as number[] };

  const layout = () => {
    const s = story.getBoundingClientRect();
    const b = baseline.getBoundingClientRect();
    const first = stations[0]?.getBoundingClientRect();
    const x = first ? first.left + first.width / 2 - s.left : b.left - s.left;
    const bx = b.left - s.left;
    const y0 = b.top - s.top + b.height / 2;
    const y1 = end.getBoundingClientRect().top - s.top;
    const d = `M${bx},${y0} H${x} V${y1}`;
    track.setAttribute('d', d);
    lit.setAttribute('d', d);
    const total = lit.getTotalLength();
    lit.style.strokeDasharray = `${total} ${total}`;
    geo = {
      x, y0, total,
      len: Math.max(0, y1 - y0),
      lead: Math.abs(x - bx),
      stops: stations.map((st) => { const r = st.getBoundingClientRect(); return r.top + r.height / 2 - s.top; }),
    };
    draw();
  };

  const draw = () => {
    const view = -story.getBoundingClientRect().top + window.innerHeight * 0.62;
    const down = Math.min(geo.len, Math.max(0, view - geo.y0));
    lit.style.strokeDashoffset = String(reduce ? 0 : geo.total - geo.lead - down);
    head.setAttribute('cx', String(geo.x));
    head.setAttribute('cy', String(geo.y0 + down));
    head.style.opacity = !reduce && down > 0 && down < geo.len ? '1' : '0';
    rows.forEach((r, i) => r.classList.toggle('reached', reduce || view >= geo.stops[i]));
  };

  let frame = 0;
  window.addEventListener('scroll', () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(draw); }, { passive: true });
  new ResizeObserver(() => layout()).observe(story);
  document.fonts?.ready.then(layout);
  layout();

  // The bridge lights up word by word.
  const bridge = document.querySelector<HTMLElement>('[data-bridge]')!;
  const words = [...bridge.querySelectorAll<HTMLElement>('.bridge-text span')];
  const lightBridge = () => {
    const r = bridge.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, -r.top / (r.height - window.innerHeight) * 1.25));
    words.forEach((w, i) => w.classList.toggle('on', reduce || i / words.length < p));
  };
  window.addEventListener('scroll', lightBridge, { passive: true });
  lightBridge();

  // Fit the wordmark's viewBox to the real text once its font has loaded.
  const wm = document.querySelector<SVGSVGElement>('[data-wordmark]');
  const fitWordmark = () => {
    const t = wm?.querySelector<SVGTextElement>('.wm-outline');
    if (!wm || !t) return;
    const bb = t.getBBox();
    const pad = 4;
    wm.setAttribute('viewBox', `${bb.x - pad} ${bb.y - pad} ${bb.width + pad * 2} ${bb.height + pad * 2}`);
  };
  document.fonts?.ready.then(fitWordmark);
  fitWordmark();

  // The loop draws its branches once it comes into view.
  const loop = document.querySelector<HTMLElement>('[data-loop]')!;
  new IntersectionObserver(([e], obs) => {
    if (e.isIntersecting) { loop.classList.add('drawn'); obs.disconnect(); }
  }, { threshold: 0.35 }).observe(loop);
</script>
