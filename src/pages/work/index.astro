---
import Base from '../../layouts/Base.astro';
import ProjectRows from '../../components/ProjectRows.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<Base title="Work" description="Projects by Ahmad Azim.">
  <section class="wrap page">
    <h1>Work</h1>
    <p class="muted lede">Five projects. Each page shows how it works and where every number comes from.</p>
    <ProjectRows projects={projects} />
  </section>
</Base>

<style>
  .page { padding-top: 3rem; }
  h1 { font-size: clamp(3rem, 9vw, 6rem); margin: 0; }
  .lede { margin: 0.75rem 0 2.5rem; }
</style>
