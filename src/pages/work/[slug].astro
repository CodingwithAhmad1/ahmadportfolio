---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<Base title={d.title} description={d.tagline}>
  <article>
    <header class="head in-world" data-world={project.id}>
      <div class="wrap">
      <a class="back" href={project.data.flagship ? '/#engine' : `/#${project.id}`}>Back to the demo</a>
      <h1 style={`view-transition-name: title-${project.id}`}>{d.title}</h1>
      <p class="tagline">{d.tagline}</p>
      <dl class="facts">
        <div><dt>Year</dt><dd>{d.year}</dd></div>
        <div><dt>Status</dt><dd>{d.status}</dd></div>
        <div class="stack"><dt>Built with</dt><dd>{d.stack.join(', ')}</dd></div>
        {d.links.live && <div><dt>Live</dt><dd><a href={d.links.live}>{new URL(d.links.live).host}</a></dd></div>}
        {d.links.repo && <div><dt>Source</dt><dd><a href={d.links.repo}>GitHub</a></dd></div>}
      </dl>
      </div>
    </header>

    <div class="wrap prose case">
      <Content />
    </div>

    <nav class="wrap next" aria-label="Next project" data-world={next.id}>
      <a href={`/work/${next.id}`}>
        <span class="muted">Next project</span>
        <span class="next-title">{next.data.title}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .head { padding: 3rem 0 3.5rem; }
  .back { font-family: var(--display); font-size: 0.95rem; }
  h1 {
    font-size: clamp(3.5rem, 13vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin: 1.5rem 0 1rem;
    font-weight: 800;
  }
  .tagline { font-size: clamp(1.4rem, 2.6vw, 1.9rem); line-height: 1.3; max-width: 32ch; margin: 0; }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 2.5rem 0 0;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .facts dt { font-family: var(--display); font-size: 0.8rem; color: var(--muted); }
  .facts dd { margin: 0; }
  .facts .stack { flex: 1 1 18rem; }

  .case { margin-top: 3rem; }
  .case :global(h2) { font-size: clamp(1.6rem, 3vw, 2.1rem); margin: 3.5rem 0 1rem; }
  .case :global(p), .case :global(li) { line-height: 1.7; }
  .case :global(ul) { padding-left: 1.2rem; }
  .case :global(li) { margin-bottom: 0.5rem; }
  .case :global(pre) {
    max-width: 52rem;
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.55;
  }
  .case :global(p code), .case :global(li code) {
    font-size: 0.85em;
    background: var(--paper-2);
    padding: 0.1em 0.3em;
    border-radius: 3px;
  }
  .case :global(.shot) {
    display: block;
    width: 100%;
    margin: 3rem 0;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .case :global(.shot.narrow) { max-width: 640px; }

  .next { margin-top: 6rem; }
  .next a {
    display: grid;
    gap: 0.25rem;
    padding: 2rem 0;
    border-top: 2px solid var(--ink);
    text-decoration: none;
  }
  .next a:hover .next-title { color: var(--world); }
  .next-title { transition: color 0.3s; font: 800 clamp(2.5rem, 8vw, 5rem) / 1 var(--display); letter-spacing: -0.03em; }
</style>
