---
import Base from '../layouts/Base.astro';
import { projects } from '../site';
---

<Base title="Work" description="Projects I've built.">
  <section class="wrap page">
    <h1>Work</h1>
    <p class="muted lede">Things I've built, newest first.</p>
    <ul class="rows">
      {projects.map((p) => (
        <li>
          <a href={p.href}>
            <span class="title">{p.title}</span>
            <span class="meta">{p.stack}, {p.year}</span>
            <span class="summary">{p.summary}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page { padding-top: 3rem; }
  h1 { font-size: clamp(3rem, 9vw, 6rem); margin: 0; }
  .lede { margin: 0.75rem 0 2.5rem; }
</style>
