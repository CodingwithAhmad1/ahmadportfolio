---
// Text whose letters thicken as the pointer comes near. Screen readers get the
// plain string; each letter is its own span for the effect.
interface Props {
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;
let i = 0;
const words = text.split(' ').map((w) => [...w].map((ch) => ({ ch, i: i++ })));
---

<span class:list={['flex', className]} aria-label={text}>
  {words.map((word, w) => (
    <>
      <span class="word" aria-hidden="true">
        {word.map((c) => <span class="ch" style={`--i:${c.i}`}>{c.ch}</span>)}
      </span>
      {w < words.length - 1 && ' '}
    </>
  ))}
</span>
