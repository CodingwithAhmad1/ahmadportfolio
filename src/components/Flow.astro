---
// A pipeline drawn as connected steps. `loop` adds a return arrow from the last step.
interface Props {
  steps: { title: string; detail: string }[];
  loop?: string;
  label: string;
}
const { steps, loop, label } = Astro.props;
---

<figure class="flow wide" aria-label={label}>
  <ol>
    {steps.map((s) => (
      <li>
        <strong>{s.title}</strong>
        <span>{s.detail}</span>
      </li>
    ))}
  </ol>
  {loop && <p class="loop"><span aria-hidden="true">↺</span> {loop}</p>}
</figure>

<style>
  .flow { margin: 2.5rem 0; max-width: 72rem; }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    counter-reset: step;
  }
  li {
    counter-increment: step;
    position: relative;
    padding: 2.25rem 1.25rem 0 0;
    border-top: 2px solid var(--ink);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  li::before {
    content: counter(step);
    position: absolute;
    top: -0.8rem;
    left: 0;
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--display);
    font-size: 0.8rem;
    font-weight: 700;
  }
  li:last-child { border-top-color: var(--accent); }
  li:last-child::before { background: var(--accent); }
  strong { display: block; font-family: var(--display); font-weight: 600; margin-bottom: 0.35rem; }
  span { color: var(--muted); }
  .loop { margin: 1.25rem 0 0; font-family: var(--display); font-size: 0.95rem; color: var(--accent); }
  @media (max-width: 760px) {
    ol { grid-auto-flow: row; gap: 0; }
    li { border-top: 0; border-left: 2px solid var(--ink); padding: 0 0 1.5rem 1.75rem; }
    li::before { top: 0; left: -0.85rem; }
    li:last-child { border-left-color: var(--accent); }
  }
</style>
