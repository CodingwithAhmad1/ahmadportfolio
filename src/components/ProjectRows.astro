---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---

<ul class="rows projects">
  {projects.map((p) => (
    <li>
      <a href={`/work/${p.id}`}>
        <span class="title" style={`view-transition-name: title-${p.id}`}>{p.data.title}</span>
        <span class="meta">{p.data.status}, {p.data.year}</span>
        <span class="summary">{p.data.tagline}</span>
        <span class="proof">{p.data.proof}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .proof {
    grid-column: 1 / -1;
    font-family: var(--display);
    font-size: 0.9rem;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, opacity 0.3s ease;
  }
  a:hover .proof, a:focus-visible .proof { max-height: 4rem; opacity: 1; }
  @media (hover: none) {
    .proof { max-height: none; opacity: 1; }
  }
</style>
