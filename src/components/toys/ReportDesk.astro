---
// A report types itself onto the page. As it does, the facts in it light up, a
// meter fills for each detail an investigator needs, and ReportIQ's next question
// rewrites itself until nothing is missing. Then it's yours to type over.
// The fact-spotting is a crude in-browser stand-in (the real system uses a language
// model); the gap rules and question wording are ReportIQ's real defaults, from
// backend/app/prompts/intake_gaps.py, lightly trimmed.
const gaps = [
  {
    field: 'specific_examples_present',
    label: 'A specific example',
    q: "If you can, one brief example really helps, roughly when, where, and what happened.",
  },
  {
    field: 'witnesses_mentioned',
    label: 'Witnesses or records',
    q: "Is there anyone who could corroborate what you shared, or any records that might help? Share only what you're comfortable with.",
  },
  {
    field: 'prior_reporting_mentioned',
    label: 'Raised before',
    q: 'Have you raised this concern before (for example with a manager or HR)? A short note on when and how helps; a simple no is fine too.',
  },
  {
    field: 'impact_described',
    label: 'Impact',
    q: "Has this affected you or others in any way you're willing to describe? A few words is fine.",
  },
  {
    field: 'retaliation_mentioned',
    label: 'Retaliation',
    q: 'Have you noticed, or do you worry about, any negative response tied to speaking up? Share only what feels safe for you.',
  },
];

const script = [
  'My manager is doing something wrong and nobody cares.',
  "On 14 May I saw my manager Daniel Reyes approve his brother's invoices. Priya saw it too. I told HR, and since then I've been left off the rota.",
];
---

<div class="desk" data-desk>
  <div class="paper">
    <div class="mirror" aria-hidden="true" data-mirror></div>
    <label class="visually-hidden" for="report-text">Write a report</label>
    <textarea id="report-text" rows="3" spellcheck="false" placeholder="Describe what happened. Nothing you type leaves this page." data-text>{script[0]}</textarea>
  </div>

  <ol class="meter" aria-label="Details an investigator needs">
    {gaps.map((g) => (
      <li data-rule={g.field}><span class="bar" aria-hidden="true"></span>{g.label}</li>
    ))}
  </ol>

  <div class="ask" aria-live="polite">
    <p class="ask-label">ReportIQ asks</p>
    <p class="ask-q" data-ask></p>
  </div>

  <script type="application/json" data-gaps set:html={JSON.stringify(gaps)} />
  <script type="application/json" data-script set:html={JSON.stringify(script)} />
</div>

<style>
  .desk { display: grid; gap: clamp(1.5rem, 3vw, 2.25rem); }

  /* The report: a sheet of paper. A mirror behind the textarea carries the highlights,
     so the text stays editable and the sheet grows with it. */
  .paper {
    display: grid;
    border: 2px solid var(--ink);
    background: color-mix(in srgb, var(--paper) 45%, #fff);
    box-shadow: 10px 10px 0 var(--ink);
  }
  .mirror, textarea {
    grid-area: 1 / 1;
    margin: 0;
    padding: clamp(0.9rem, 2vw, 1.25rem);
    border: 0;
    font: clamp(1rem, 1.35vw, 1.1rem) / 1.55 var(--body);
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }
  .mirror { color: transparent; pointer-events: none; }
  textarea {
    resize: none;
    overflow: hidden;
    background: transparent;
    color: var(--ink);
    caret-color: var(--ink);
  }
  textarea:focus { outline: none; }
  textarea::placeholder { color: var(--muted); }
  .paper:focus-within { box-shadow: 14px 14px 0 var(--ink); }
  .paper { transition: box-shadow 0.25s ease; }

  /* A highlighter stroke that draws across each fact as it's found. */
  .mirror :global(mark) {
    color: transparent;
    border-radius: 3px;
    background: linear-gradient(var(--world), var(--world)) no-repeat 0 0 / 100% 100%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .mirror :global(mark.new) { animation: swipe 0.45s cubic-bezier(0.3, 0.7, 0.2, 1) both; }
  @keyframes swipe { from { background-size: 0% 100%; } }

  /* Five details an investigator needs. Each bar fills when the report covers it. */
  .meter { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.5rem; }
  .meter li { display: grid; gap: 0.45rem; font: 600 0.78rem / 1.2 var(--display); opacity: 0.55; transition: opacity 0.3s ease; }
  .bar { height: 6px; background: color-mix(in srgb, var(--ink) 18%, transparent); position: relative; overflow: hidden; }
  .bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .meter li.met { opacity: 1; }
  .meter li.met .bar::after { transform: scaleX(1); }

  .ask { min-height: 7.5em; }
  .ask-label { margin: 0 0 0.4rem; font: 500 0.75rem var(--code); letter-spacing: 0.08em; text-transform: uppercase; }
  .ask-q {
    margin: 0;
    max-width: 30ch;
    font: 600 clamp(1.4rem, 2.6vw, 2.1rem) / 1.15 var(--display);
    letter-spacing: -0.02em;
  }
  .ask-q::after {
    content: '';
    display: inline-block;
    width: 0.08em;
    height: 0.9em;
    margin-left: 0.08em;
    vertical-align: -0.1em;
    background: currentColor;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  @media (max-width: 560px) {
    .meter { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.3rem; }
    .meter li { font-size: 0.62rem; }
  }
</style>

<script>
  type Gap = { field: string; label: string; q: string };

  const MONTHS = 'January|February|March|April|May|June|July|August|September|October|November|December';
  const STOP = new Set(['I', 'My', 'The', 'Since', 'He', 'She', 'They', 'We', 'It', 'HR', 'This', 'That', 'When', 'After', 'Before', 'Our', 'His', 'Her', 'A', 'An', 'On', 'In', 'At', 'And', 'But', 'Nobody', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday', ...MONTHS.split('|')]);
  const has = (t: string, re: RegExp) => re.test(t);
  const uniq = (xs: string[]) => [...new Set(xs.map((x) => x.trim()))].filter(Boolean);

  // A crude stand-in for the language model: enough to show the shape of layer 1.
  function extract(text: string) {
    const dates = uniq(text.match(new RegExp(`\\b(?:\\d{1,2}\\s+)?(?:${MONTHS})(?:\\s+\\d{4})?\\b|\\b(?:19|20)\\d{2}\\b|\\blast (?:week|month|year)\\b|\\byesterday\\b`, 'gi')) ?? []);
    const places = uniq([...text.matchAll(/\b(?:at|in) the ([A-Z][a-z]+(?: [A-Z][a-z]+)?) (?:site|office|branch|plant|warehouse|store)\b/g)].map((m) => m[1]));
    const people = uniq(
      [...text.matchAll(/\b([A-Z][a-z]+(?: [A-Z][a-z]+)?)\b/g)]
        .map((m) => m[1])
        .filter((n) => !n.split(' ').some((w) => STOP.has(w)) && !places.includes(n)),
    );
    return {
      dates,
      people,
      places,
      specific_examples_present: dates.length > 0 && has(text, /\b(saw|seen|watched|heard|on \d|approved|signed|sent|took|told me)\b/i),
      witnesses_mentioned: has(text, /\b(saw it too|also saw|witness|colleague|coworker|others saw|screenshots?|emails?|records?|receipts?)\b/i),
      prior_reporting_mentioned: has(text, /\b(told|reported|raised|complained|flagged|emailed)\b.{0,40}\b(HR|manager|supervisor|compliance|ethics|hotline|director)\b|\bHR\b.{0,20}\b(told|said|knows)/i),
      impact_described: has(text, /\b(affected|stress|anxious|lost|cost|harm|unsafe|injur|money|sick|rota|hours|pay)\b/i),
      retaliation_mentioned: has(text, /\b(since then|retaliat|punish|left off|demoted|threat|afraid|worried|scared|isolated|excluded)\b/i),
    };
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-desk]')) {
    const gaps: Gap[] = JSON.parse(root.querySelector('[data-gaps]')!.textContent!);
    const script: string[] = JSON.parse(root.querySelector('[data-script]')!.textContent!);
    const input = root.querySelector<HTMLTextAreaElement>('[data-text]')!;
    const mirror = root.querySelector<HTMLElement>('[data-mirror]')!;
    const ask = root.querySelector<HTMLElement>('[data-ask]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let seen = new Set<string>();
    let lastAsk = '';
    let typing = 0;

    // Redraw the text behind the textarea with every found fact wrapped in a mark.
    const highlight = (text: string, facts: string[]) => {
      const spans: [number, number][] = [];
      for (const f of facts) {
        for (let i = text.indexOf(f); i !== -1; i = text.indexOf(f, i + f.length)) spans.push([i, i + f.length]);
      }
      spans.sort((a, b) => a[0] - b[0]);
      const next = new Set<string>();
      const out: Node[] = [];
      let at = 0;
      for (const [a, b] of spans) {
        if (a < at) continue;
        out.push(document.createTextNode(text.slice(at, a)));
        const m = document.createElement('mark');
        m.textContent = text.slice(a, b);
        const key = `${a}:${m.textContent}`;
        if (!seen.has(key) && !reduce) m.className = 'new';
        next.add(key);
        out.push(m);
        at = b;
      }
      // A trailing space keeps the mirror as tall as the textarea after a final newline.
      out.push(document.createTextNode(text.slice(at) + ' '));
      mirror.replaceChildren(...out);
      seen = next;
    };

    // The question types itself out whenever it changes.
    const say = (text: string) => {
      clearInterval(typing);
      if (reduce) { ask.textContent = text; return; }
      let i = 0;
      ask.textContent = '';
      typing = window.setInterval(() => {
        ask.textContent = text.slice(0, ++i);
        if (i >= text.length) clearInterval(typing);
      }, 16);
    };

    const run = () => {
      const r = extract(input.value) as Record<string, unknown> & { dates: string[]; people: string[]; places: string[] };
      highlight(input.value, [...r.dates, ...r.people, ...r.places]);
      const missing = gaps.filter((g) => {
        const met = Boolean(r[g.field]);
        root.querySelector(`[data-rule="${g.field}"]`)!.classList.toggle('met', met);
        return !met;
      });
      const key = input.value.trim() ? missing[0]?.field ?? 'done' : 'empty';
      if (key === lastAsk) return;
      lastAsk = key;
      if (key === 'empty') say('What happened?');
      else if (key === 'done') say('Nothing missing. Ready for an investigator.');
      else say(missing[0].q);
    };

    // The opening act: the vague report, the question it earns, then the detailed one
    // typed over it. Stops for good the moment the visitor touches the text.
    let playing = false;
    let stopped = false;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const type = async (text: string, speed: number) => {
      for (let i = 1; i <= text.length && !stopped; i++) {
        input.value = text.slice(0, i);
        run();
        await wait(speed);
      }
    };
    const play = async () => {
      if (playing || stopped || reduce) return;
      playing = true;
      input.value = '';
      run();
      await wait(400);
      await type(script[0], 22);
      await wait(2600);
      for (let n = input.value.length; n >= 0 && !stopped; n -= 4) { input.value = input.value.slice(0, n); run(); await wait(10); }
      await type(script[1], 16);
      playing = false;
    };
    const stop = () => { stopped = true; };
    input.addEventListener('pointerdown', stop);
    input.addEventListener('keydown', stop);
    input.addEventListener('input', run);
    new IntersectionObserver(([e]) => { if (e.isIntersecting) play(); }, { threshold: 0.5 }).observe(root);
    run();
  }
</script>
