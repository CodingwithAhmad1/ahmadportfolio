---
// A deck of the landmark cases JurisLearning explains, taken from its seed data.
import cases from '../../data/juris-cases.json';

const first = cases[0];
---

<div class="deck" data-deck>
  <div class="stack">
    <span class="ghost g2" aria-hidden="true"></span>
    <span class="ghost g1" aria-hidden="true"></span>
    <article class="card" data-card aria-live="polite">
      <p class="year" data-f="year">{first.year}</p>
      <h4 data-f="title">{first.title}</h4>
      <p class="court" data-f="court">{first.court}</p>
      <p class="facts" data-f="facts">{first.facts}</p>
      <p class="why"><b>Why it matters.</b> <span data-f="why">{first.why}</span></p>
    </article>
  </div>
  <div class="controls">
    <button type="button" data-next>Next case</button>
    <span class="pos"><span data-pos>1</span> of {cases.length}</span>
  </div>
  <script type="application/json" data-cases set:html={JSON.stringify(cases)} />
</div>

<style>
  .deck { max-width: 44rem; }
  .stack { position: relative; padding: 0 0 1.25rem 1.25rem; }
  .ghost, .card { border-radius: 10px; }
  .ghost { position: absolute; inset: 0 1.25rem 1.25rem 0; background: var(--ink); }
  .g1 { transform: translate(0.6rem, 0.6rem); opacity: 0.35; }
  .g2 { transform: translate(1.2rem, 1.2rem); opacity: 0.18; }
  .card {
    position: relative;
    background: #f6f1e7;
    color: #1a1012;
    padding: clamp(1.25rem, 3vw, 2rem);
    min-height: 22rem;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.2);
    transition: transform 0.4s cubic-bezier(0.3, 0.7, 0.2, 1), opacity 0.4s;
  }
  .card.out { transform: translateX(110%) rotate(8deg); opacity: 0; }
  .card.in { transform: translateY(1rem) scale(0.97); opacity: 0; transition: none; }
  .year { margin: 0; font: 800 clamp(3rem, 7vw, 4.5rem) / 1 var(--display); letter-spacing: -0.03em; color: #c22a4f; }
  h4 { margin: 0.5rem 0 0.15rem; font: 700 1.35rem / 1.2 var(--display); }
  .court { margin: 0 0 1rem; font-size: 0.9rem; opacity: 0.7; }
  .facts, .why { margin: 0 0 0.75rem; font-size: 1rem; line-height: 1.55; }
  .why b { font-family: var(--display); font-size: 0.9rem; }
  .controls { display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem; }
  button {
    font: 700 0.95rem var(--display);
    color: var(--paper);
    background: var(--ink);
    border: 0;
    border-radius: 999px;
    padding: 0.6rem 1.3rem;
    cursor: pointer;
  }
  button:hover { transform: translateY(-1px); }
  .pos { font: 600 0.85rem var(--display); color: var(--muted); font-variant-numeric: tabular-nums; }
</style>

<script>
  type Case = { title: string; year: number; court: string; facts: string; why: string };

  for (const root of document.querySelectorAll<HTMLElement>('[data-deck]')) {
    const cases: Case[] = JSON.parse(root.querySelector('[data-cases]')!.textContent!);
    const card = root.querySelector<HTMLElement>('[data-card]')!;
    const pos = root.querySelector<HTMLElement>('[data-pos]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;

    const fill = (c: Case) => {
      for (const el of card.querySelectorAll<HTMLElement>('[data-f]')) {
        el.textContent = String(c[el.dataset.f as keyof Case]);
      }
      pos.textContent = String(i + 1);
    };

    root.querySelector('[data-next]')!.addEventListener('click', () => {
      i = (i + 1) % cases.length;
      if (reduce) { fill(cases[i]); return; }
      card.classList.add('out');
      setTimeout(() => {
        fill(cases[i]);
        card.classList.remove('out');
        card.classList.add('in');
        void card.offsetWidth;
        card.classList.remove('in');
      }, 260);
    });
  }
</script>
