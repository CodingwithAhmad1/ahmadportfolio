---
import { socials } from '../site';
---

<ul class="socials">
  {socials.map(({ label, href }) => (
    <li><a href={href} rel="me noopener" target={href.startsWith('http') ? '_blank' : undefined}>{label}</a></li>
  ))}
</ul>

<style>
  .socials { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  a { font-family: var(--display); font-weight: 500; }
</style>
